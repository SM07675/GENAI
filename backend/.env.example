# ============================================================
#  Genie backend configuration.
#  Copy this file to `.env` and fill in your values.
#  Every variable below can ALSO be set as a real env var.
# ============================================================

# --- Gemini reasoning engine (OpenAI-compatible endpoint) --------------
# Get a key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.6
GEMINI_MAX_TOKENS=4096

# --- Speech-to-text ------------------------------------------------------
# Default is local faster-whisper (offline, no key). Switch to "whisper_api"
# only if you set OPENAI_API_KEY and want the cloud Whisper API.
STT_ENGINE=faster_whisper
WHISPER_MODEL_SIZE=small
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_LANGUAGE=
OPENAI_API_KEY=

# --- Text-to-speech ------------------------------------------------------
# "edge" = free Microsoft Edge TTS (default).
# "elevenlabs" = high-fidelity voice (requires ELEVENLABS_API_KEY, paid).
# "gemini_live" = Gemini Live native audio voice (uses GEMINI_API_KEY).
TTS_ENGINE=edge
EDGE_VOICE=en-US-AriaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE_NAME=Aoede
GEMINI_LIVE_STYLE=Speak naturally, warmly, and briefly. Use human pacing, small pauses, and the same language as the text. Do not add extra content.

# --- Ngrok (secure public URL for the mobile web client) ----------------
NGROK_ENABLED=true
# Strongly recommended: a free authtoken gives stable, persistent tunnels.
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
NGROK_REGION=

# --- External APIs -------------------------------------------------------
# YouTube Music has no official public API. Genie uses YouTube Data API for
# official search metadata, then opens playback on music.youtube.com.
YOUTUBE_DATA_API_KEY=
YOUTUBE_REGION_CODE=IN
YOUTUBE_MUSIC_PROVIDER=auto

# Search/news providers are optional. Genie tries official APIs, then free fallbacks.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
NEWS_API_KEY=
GNEWS_API_KEY=
THENEWSAPI_KEY=
NEWS_DEFAULT_COUNTRY=in
NEWS_DEFAULT_LANGUAGE=en

# Spotify credentials are optional for future media integrations/status.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Shared API behavior.
API_TIMEOUT_SECONDS=10
API_CACHE_TTL_SECONDS=300
API_RATE_LIMIT_PER_MINUTE=45
API_CIRCUIT_FAILURE_THRESHOLD=3
API_CIRCUIT_COOLDOWN_SECONDS=60

# --- Security ------------------------------------------------------------
# 4-digit PIN shown in the desktop UI; mobile must enter it to connect.
# Leave blank to auto-generate a fresh PIN on every backend start.
GENIE_PIN=

# --- Wake Word Detection (Optional, hands-free activation) ---------------
# Enable always-on listening for "Hey Genie" or "Okay Genie"
# Set to true to enable wake word detection on server startup
WAKE_WORD_ENABLED=false
# Engine: "simple" (basic, no deps), "vosk" (offline, accurate), "porcupine" (best, needs API key)
WAKE_WORD_ENGINE=simple
# Custom keywords (comma-separated, for vosk/porcupine only)
# WAKE_WORD_KEYWORDS=hey genie,okay genie,hi genie

# --- Server --------------------------------------------------------------
HOST=127.0.0.1
PORT=8765
